# AI assistant of francerouelibre.fr (server/assistant_api.py). On the PC these keys are read from the repo's .env
# (the RevoFlow one, ignored by git). On the VPS: copy this file to /etc/francerouelibre/assistant.env (root, mode 600),
# fill it in, then run deploy_vps.bat; without that file the assistant is not installed and the site does not show it.

# ---- Gemini on Vertex AI, billed to the Google Cloud trial credits (billing lock: nothing is sent if the project is
# not on this billing account). On the VPS, a service account key with the roles "Vertex AI User" and "Browser",
# copied to /etc/francerouelibre/vertex-sa.json (root, mode 600): systemd hands it to the service, never the repo.
GEMINI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_BILLING_ACCOUNT=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low

# ---- Claude (Anthropic API key, console.anthropic.com > API keys). Also set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=medium

# ---- Hard caps (euros, prices counted 1 $ = 1 € to stay on the safe side). Defaults shown.
# Claude's monthly envelope, like the credits themselves: euros the Loupe may spend from a start to an end date, then a
# new credit on each monthly day, lost on CLAUDE_EXPIRE_DAY of the next month if not spent (0 = never lost).
# CLAUDE_MONTHLY_EUR=90        (0 = no envelope: the cap in all below applies instead)
# CLAUDE_MONTH_DAY=9
# CLAUDE_EXPIRE_DAY=11
# CLAUDE_ENVELOPE_START=2026-11-11T10:25
# CLAUDE_ENVELOPE_EUR=88
# CLAUDE_ENVELOPE_EXPIRES=2026-12-11
# CLAUDE_BUDGET_EUR=150        (Claude in all, only without envelope; never above CLAUDE_MAX_USD of settings.py)
# CLAUDE_DAILY_EUR=15          (Claude alone for one day; 0 = no cap of its own)
# GEMINI_DAILY_EUR=0
# GEMINI_BUDGET_EUR=100
# GEMINI_UNTIL=2026-11-17
# ASSISTANT_DAILY_EUR=10       (both providers together for one day)
# ASSISTANT_ORDER=claude,gemini

# ---- Limits for the public (defaults shown)
# ASSISTANT_PER_IP_HOUR=15
# ASSISTANT_PER_IP_DAY=40
# ASSISTANT_DAILY_QUESTIONS=500
# ASSISTANT_MAX_JOBS=4
# ASSISTANT_MAX_STEPS=8
# Recherches web par question avec Claude (10 $ les 1 000 : l’essentiel du prix d’une recherche). 1 = moitié moins cher.
# ASSISTANT_CLAUDE_SEARCHES=2
# Sites officiels en plus dont les rapports PDF sont lus (server/assistant/pdf.py), séparés par des virgules.
# ASSISTANT_PDF_HOSTS=

# ---- Requests to public bodies (« Demandes aux instances publiques », server/assistant/demandes.py)
# The password of stonks@francerouelibre.fr is NOT written here: run mail_credentials.bat on the PC, which stores it
# encrypted on the VPS (systemd-creds). Defaults: OVH Zimbra (ssl0.ovh.net:465, imap.mail.ovh.net:993).
# MAIL_AUTO_SEND=0          # 0: each request waits for your validation (frl-demandes valider FRL-...)
# MAIL_DAILY=20
# MAIL_PER_BODY_MONTH=2
