# AI assistant of francerouelibre.fr (server/assistant_api.py). On the PC these keys are read from the repo's .env
# (the RevoFlow one, ignored by git). On the VPS: copy this file to /etc/francerouelibre/assistant.env (root, mode 600),
# fill it in, then run deploy_vps.bat; without that file the assistant is not installed and the site does not show it.

# ---- Gemini on Vertex AI, billed to the Google Cloud trial credits (billing lock: nothing is sent if the project is
# not on this billing account). On the VPS, a service account key with the roles "Vertex AI User" and "Browser",
# copied to /etc/francerouelibre/vertex-sa.json (root, mode 600): systemd hands it to the service, never the repo.
GEMINI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_BILLING_ACCOUNT=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low

# ---- Claude (Anthropic API key, console.anthropic.com > API keys). Also set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=medium

# ---- Hard caps (euros, prices counted 1 $ = 1 € to stay on the safe side). Defaults shown.
# CLAUDE_BUDGET_EUR=50
# GEMINI_BUDGET_EUR=100
# GEMINI_UNTIL=2026-11-17
# ASSISTANT_DAILY_EUR=10
# ASSISTANT_ORDER=gemini,claude

# ---- Limits for the public (defaults shown)
# ASSISTANT_PER_IP_HOUR=15
# ASSISTANT_PER_IP_DAY=40
# ASSISTANT_DAILY_QUESTIONS=500
# ASSISTANT_MAX_JOBS=4
# ASSISTANT_MAX_STEPS=8

# ---- Requests to public bodies (« Demandes aux instances publiques », server/assistant/demandes.py)
# The mailbox stonks@francerouelibre.fr: values given by the mail host (OVH, Gandi, Infomaniak, Zoho...). Prefer an
# application password if the host offers one. Without these lines readers can only copy the letter.
# MAIL_SMTP_HOST=ssl0.ovh.net
# MAIL_SMTP_PORT=465
# MAIL_IMAP_HOST=ssl0.ovh.net
# MAIL_IMAP_PORT=993
# MAIL_USER=stonks@francerouelibre.fr
# MAIL_PASSWORD=
# MAIL_FROM=stonks@francerouelibre.fr
# MAIL_FROM_NAME=FranceRoueLibre
# MAIL_AUTO_SEND=0          # 0: each request waits for your validation (--demandes valider FRL-...)
# MAIL_DAILY=5
# MAIL_PER_BODY_MONTH=2
# MAIL_ADMIN_TOKEN=         # any long random string: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
